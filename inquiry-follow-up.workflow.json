        "jsCode": "const input = $json.body ?? $json;\nconst clean = (value, max) => String(value ?? '').trim().slice(0, max);\nconst name = clean(input.name, 120);\nconst email = clean(input.email, 254).toLowerCase();\nconst phone = clean(input.phone, 40);\nconst message = clean(input.message, 2000);\nconst website = clean(input.website, 500);\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\nif (website !== '') throw Object.assign(new Error('Rejected: honeypot field must be empty.'), { httpCode: 400 });\nif (!name || !emailOk || !message) throw Object.assign(new Error('Rejected: name, valid email, and message are required.'), { httpCode: 400 });\nreturn [{ json: { name, email, phone, message, received_at: new Date().toISOString() } }];"
      },
